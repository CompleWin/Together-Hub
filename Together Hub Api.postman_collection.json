        {
          "name": "/create",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "if (response)\r",
                  "{\r",
                  "    pm.collectionVariables.set(\"firstTopicId\", response.id);\r",
                  "    console.log(\"First Id topic saved: \" + response.id);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var moment = require('moment');\r",
                  "const titles = [\r",
                  "    \"Технологические тренды\",\r",
                  "    \"Будущие технологии\",\r",
                  "    \"Инновации 2030\",\r",
                  "    \"Прорывные технологии\",\r",
                  "    \"Технологии будущего\"\r",
                  "];\r",
                  "\r",
                  "const summaries = [\r",
                  "    \"Обзор ключевых технологических инноваций\",\r",
                  "    \"Анализ будущих трендов\",\r",
                  "    \"Влияние технологий на общество\",\r",
                  "    \"Ключевые достижения в науке\",\r",
                  "    \"Технологические вызовы будущего\"\r",
                  "];\r",
                  "\r",
                  "const topicTypes = [\r",
                  "    \"Конференция\",\r",
                  "    \"Семинар\",\r",
                  "    \"Вебинар\",\r",
                  "    \"Круглый стол\",\r",
                  "    \"Мастер-класс\"\r",
                  "];\r",
                  "\r",
                  "const locations = [\r",
                  "    { street: \"Кутузовский проспект, 36\", city: \"Смоленск\"},\r",
                  "    { street: \"Советская улица, 12\", city: \"Санкт-Петербург\" },\r",
                  "    { street: \"Гагарина улица, 5\", city: \"Москва\" },\r",
                  "    { street: \"Пушкина улица, 10\", city: \"Новосибирск\" },\r",
                  "    { street: \"Ленина улица, 20\", city: \"Екатеринбург\" }\r",
                  "];\r",
                  "\r",
                  "const randomDate = moment.utc()\r",
                  "            .year(Math.floor(Math.random() * (2035 - 2027 + 1)) + 2027)\r",
                  "            .month(Math.floor(Math.random() * 12))\r",
                  "            .date(Math.floor(Math.random() * 28) + 1)\r",
                  "            .hour(Math.floor(Math.random() * 24))\r",
                  "            .minute(Math.floor(Math.random() * 60))\r",
                  "            .second(0)\r",
                  "            .millisecond(0);\r",
                  "\r",
                  "const randomTitle = titles[Math.floor(Math.random() * titles.length)];\r",
                  "const randomSummary = summaries[Math.floor(Math.random() * summaries.length)];\r",
                  "const randomTopicTypes = topicTypes[Math.floor(Math.random() * topicTypes.length)];\r",
                  "const randomLocation = locations[Math.floor(Math.random() * locations.length)];\r",
                  "\r",
                  "\r",
                  "pm.environment.set(\"title\", randomTitle);\r",
                  "pm.environment.set(\"summary\", randomSummary);\r",
                  "pm.environment.set(\"topicType\", randomTopicTypes);\r",
                  "pm.environment.set(\"locationStreet\", randomLocation.street);\r",
                  "pm.environment.set(\"locationCity\", randomLocation.city);\r",
                  "pm.environment.set(\"currentDateTime\", randomDate.format(\"YYYY-MM-DDTHH:mm:ss\"));\r",
                  "\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtToken}}",
                  "type": "string"
